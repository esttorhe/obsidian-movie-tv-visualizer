{
  "name": "obsidian-movie-tv-visualizer",
  "version": "0.1.5",
  "description": "Visual movie & TV show catalog plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": ["obsidian", "movies", "tv-shows", "catalog", "film", "cinema", "series", "watchlist", "tier-list"],
  "author": "Esteban Torres",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {}
}
