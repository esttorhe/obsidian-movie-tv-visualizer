[
  {
    "schemaVersion": "0.1.0",
    "name": "IMDb Movie",
    "behavior": "create",
    "noteContentFormat": "",
    "properties": [
      {
        "name": "title",
        "value": "{{title}}",
        "type": "text"
      },
      {
        "name": "titleOriginal",
        "value": "{{title}}",
        "type": "text"
      },
      {
        "name": "imdbId",
        "value": "{{url | replace:\"https://www.imdb.com/title/\":\"\" | replace:\"/\":\"\"}}",
        "type": "text"
      },
      {
        "name": "year",
        "value": "{{selector:\"span[data-testid='title-metadata-item']:first-child\" | trim}}",
        "type": "number"
      },
      {
        "name": "runtime",
        "value": "{{selector:\"li[data-testid='title-techspec_runtime'] .ipc-metadata-list-item__content-container\" | trim}}",
        "type": "text"
      },
      {
        "name": "director",
        "value": "{{selector:\"a[href*='/name/'][data-testid='title-pc-principal-credit']\" | list}}",
        "type": "multitext"
      },
      {
        "name": "cast",
        "value": "{{selector:\".ipc-metadata-list-item__label:contains('Stars') ~ .ipc-metadata-list-item__content-container a\" | list | slice:0:5}}",
        "type": "multitext"
      },
      {
        "name": "genre",
        "value": "{{selector:\".ipc-chip--on-baseAlt .ipc-chip__text\" | list}}",
        "type": "multitext"
      },
      {
        "name": "plot",
        "value": "{{selector:\"[data-testid='plot-xl'] span, [data-testid='plot-l'] span\" | trim}}",
        "type": "text"
      },
      {
        "name": "scoreImdb",
        "value": "{{selector:\"[data-testid='hero-rating-bar__aggregate-rating__score'] span:first-child\" | trim}}",
        "type": "number"
      },
      {
        "name": "cover",
        "value": "{{selector:\".ipc-image\"?src}}",
        "type": "text"
      },
      {
        "name": "favorite",
        "value": "false",
        "type": "checkbox"
      },
      {
        "name": "timesWatched",
        "value": "0",
        "type": "number"
      },
      {
        "name": "watchlist",
        "value": "{{date}}",
        "type": "date"
      },
      {
        "name": "categories",
        "value": "Movies",
        "type": "multitext"
      }
    ],
    "noteNameFormat": "{{title}}",
    "path": "Movies",
    "triggers": [
      "imdb.com/title/"
    ]
  },
  {
    "schemaVersion": "0.1.0",
    "name": "IMDb TV Show",
    "behavior": "create",
    "noteContentFormat": "",
    "properties": [
      {
        "name": "title",
        "value": "{{title}}",
        "type": "text"
      },
      {
        "name": "titleOriginal",
        "value": "{{title}}",
        "type": "text"
      },
      {
        "name": "imdbId",
        "value": "{{url | replace:\"https://www.imdb.com/title/\":\"\" | replace:\"/\":\"\"}}",
        "type": "text"
      },
      {
        "name": "year",
        "value": "{{selector:\"span[data-testid='title-metadata-item']:first-child\" | trim | split:\"–\" | first}}",
        "type": "number"
      },
      {
        "name": "yearEnd",
        "value": "{{selector:\"span[data-testid='title-metadata-item']:first-child\" | trim | split:\"–\" | last}}",
        "type": "number"
      },
      {
        "name": "episodeRuntime",
        "value": "{{selector:\"li[data-testid='title-techspec_runtime'] .ipc-metadata-list-item__content-container\" | trim}}",
        "type": "text"
      },
      {
        "name": "creator",
        "value": "{{selector:\"a[href*='/name/'][data-testid='title-pc-principal-credit']\" | list}}",
        "type": "multitext"
      },
      {
        "name": "cast",
        "value": "{{selector:\".ipc-metadata-list-item__label:contains('Stars') ~ .ipc-metadata-list-item__content-container a\" | list | slice:0:5}}",
        "type": "multitext"
      },
      {
        "name": "genre",
        "value": "{{selector:\".ipc-chip--on-baseAlt .ipc-chip__text\" | list}}",
        "type": "multitext"
      },
      {
        "name": "seasons",
        "value": "{{selector:\"[data-testid='episodes-header'] .ipc-title__text, label[for='browse-episodes-season']\" | trim}}",
        "type": "number"
      },
      {
        "name": "status",
        "value": "returning",
        "type": "text"
      },
      {
        "name": "network",
        "value": "",
        "type": "text"
      },
      {
        "name": "plot",
        "value": "{{selector:\"[data-testid='plot-xl'] span, [data-testid='plot-l'] span\" | trim}}",
        "type": "text"
      },
      {
        "name": "scoreImdb",
        "value": "{{selector:\"[data-testid='hero-rating-bar__aggregate-rating__score'] span:first-child\" | trim}}",
        "type": "number"
      },
      {
        "name": "cover",
        "value": "{{selector:\".ipc-image\"?src}}",
        "type": "text"
      },
      {
        "name": "favorite",
        "value": "false",
        "type": "checkbox"
      },
      {
        "name": "timesWatched",
        "value": "0",
        "type": "number"
      },
      {
        "name": "currentSeason",
        "value": "1",
        "type": "number"
      },
      {
        "name": "currentEpisode",
        "value": "0",
        "type": "number"
      },
      {
        "name": "watchlist",
        "value": "{{date}}",
        "type": "date"
      },
      {
        "name": "categories",
        "value": "TV Shows",
        "type": "multitext"
      }
    ],
    "noteNameFormat": "{{title}}",
    "path": "TV Shows",
    "triggers": [
      "imdb.com/title/"
    ]
  }
]
